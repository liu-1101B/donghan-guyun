  "sentences": [
    {
      "text": "学而时习之，不亦说乎？",
      "source": "论语·学而"
    },
    {
      "text": "学而不思则罔，思而不学则殆。",
      "source": "论语·为政"
    },
    {
      "text": "三人行，必有我师焉。",
      "source": "论语·述而"
    },
    {
      "text": "温故而知新，可以为师矣。",
      "source": "论语·为政"
    },
    {
      "text": "己所不欲，勿施于人。",
      "source": "论语·颜渊"
    },
    {
      "text": "关关雎鸠，在河之洲。",
      "source": "诗经·关雎"
    },
    {
      "text": "桃之夭夭，灼灼其华。",
      "source": "诗经·桃夭"
    },
    {
      "text": "北冥有鱼，其名为鲲。",
      "source": "庄子·逍遥游"
    },
    {
      "text": "得道者多助，失道者寡助。",
      "source": "孟子·公孙丑下"
    },
    {
      "text": "大道之行也，天下为公。",
      "source": "礼记·礼运"
    },
    {
      "text": "普天之下，莫非王土。",
      "source": "诗经·小雅·北山"
    },
    {
      "text": "兼相爱，交相利。",
      "source": "墨子·兼爱中"
    }
  ],
